# LLM: OpenAI-compatible (DeepSeek / OpenAI / Ollama ...)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# DashScope / 百炼 API Key（千问 Embedding + Rerank）
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# Embedding: dashscope | local | hf | openai
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Rerank: dashscope | local | hf
RERANKER_PROVIDER=dashscope
RERANKER_MODEL=qwen3-rerank

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SEMANTIC_SIMILARITY_THRESHOLD=0.55

# Retrieval
RETRIEVE_TOP_K=8
RERANK_TOP_N=5
MAX_CONTEXT_CHARS=6000

# Paths
DATA_DIR=data
STORAGE_DIR=storage
